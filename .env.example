# Scrydex is the live quote feed (raw prices, trends, graded prices) and the
# path for games beyond Pokémon. Create a team at https://scrydex.com
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=

# Optional. Raises the rate limit on the public Pokémon TCG API, which is the
# quote fallback when Scrydex is not connected.
POKEMON_TCG_API_KEY=

# eBay Browse API application key. Turns auction and Buy It Now tickets
# from search links into live listings. https://developer.ebay.com
# A sandbox key (the App ID contains SBX, or the secret starts with SBX-)
# is sent to api.sandbox.ebay.com. That test marketplace does not have
# live Pokémon sales. A production key is what fills the desk with real auctions.
# EBAY_ENV=sandbox forces the test API. EBAY_ENV=production forces the live one.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace account deletion. eBay disables a production keyset until this
# endpoint answers their challenge. The token is 32–80 letters, numbers,
# hyphens, or underscores. Put the same value in the eBay developer portal.
# The endpoint string must match the portal exactly.
EBAY_DELETION_TOKEN=
EBAY_DELETION_ENDPOINT=https://charsi-app.vercel.app/api/ebay/account-deletion
# Older Trading API id. The Browse feed does not use it.
EBAY_DEV_ID=

# Optional. Public ids, not secrets. Left blank, the links still open.
# eBay Partner Network campaign id: https://partnernetwork.ebay.com
NEXT_PUBLIC_EBAY_CAMPAIGN_ID=
# TCGplayer pays commission through Impact. Paste the partner link base,
# like https://partner.tcgplayer.com/c/000/000/000 — the destination is added for you.
# https://docs.tcgplayer.com/docs/tcgplayer-affiliate-program
NEXT_PUBLIC_TCGPLAYER_PARTNER_LINK=

# Discord sign-in for My Collection (free). Create an app at
# https://discord.com/developers/applications, open OAuth2, and add the
# redirect http://localhost:4177/api/auth/discord/callback
# Needed on every machine and host. .env.local is not committed, so Vercel needs these in its own Environment Variables.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Any long random string, 16+ characters. Required in production.
SESSION_SECRET=
# Optional. The public address of the app, with no trailing slash.
APP_URL=
